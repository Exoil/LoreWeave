{
    "AppVersion": "1.0.0",
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "Serilog": {
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft": "Warning",
                "System": "Warning"
            }
        },
        "Using": [
            "Serilog.Sinks.Console",
            "Serilog.Sinks.Kafka"
        ],
        "WriteTo": [
            {
                "Name": "Console",
                "Args": {
                    "outputTemplate": "{Timestamp:HH:mm:ss.fff zzz} [{Level}] {Message} {Properties}{NewLine}{Exception}"

                }
            },
            {
                "Name": "Kafka",
                "Args": {
                    "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog",
                    "kafka": {
                        "brokers": [ "${Kafka:Broker:Uri}" ],
                        "topicName": "event.log"
                    },
                    "batch": {
                        "batchSizeLimit": 50,
                        "period": "00:00:05"
                    }
                }
            }
        ],
        "Enrich": [
            "FromLogContext",
            "WithMachineName",
            "WithProcessId",
            "WithThreadId"
        ]
    },
    "GraphDb": {
        "ConnectionString": "${Neo4j:ConnectionString}",
        "Username": "${Neo4j:UserName}",
        "Password": "${Neo4j:Password}"
    }
}
